# Got Messy — environment variables
# Copy to .env.local (never commit .env.local)

# ── Clerk (Identity) ─────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys

# Next.js / web (public key safe to expose in browser bundles)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-side secret — keep out of client bundles
CLERK_SECRET_KEY=sk_test_replace_me

# Expo / React Native
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Post-sign-in / sign-up redirect (Next.js app router)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── LLM providers (Phase 2+) ─────────────────────────────────────────────────
# OPENAI_API_KEY=sk-replace_me
# GOOGLE_GENERATIVE_AI_API_KEY=replace_me
# ANTHROPIC_API_KEY=sk-ant-replace_me

# ── Database (Phase 1+) ──────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:password@host:5432/gotmessy

# ── Object storage (Phase 1+) ────────────────────────────────────────────────
# R2_ACCOUNT_ID=replace_me
# R2_ACCESS_KEY_ID=replace_me
# R2_SECRET_ACCESS_KEY=replace_me
# R2_BUCKET_NAME=gotmessy-assets
